generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials provider
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  // User data
  incomes       Income[]
  expenses      Expense[]
  cards         CreditCard[]
  categories    Category[]
  budgets       Budget[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String    // "INCOME" or "EXPENSE"
  color     String    @default("#3b82f6") // blue-500
  icon      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  incomes   Income[]
  expenses  Expense[]
  budgets   Budget[]
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month      Int      // 1-12
  year       Int
  limit      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, month, year])
}

model Income {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  date        DateTime
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  received    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  dueDate     DateTime
  paidAt      DateTime?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isFixed     Boolean   @default(false)
  isPaid      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CreditCard {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  limit          Float
  closingDay     Int
  dueDay         Int
  color          String            @default("nubank") // nubank, inter, c6blue, black, platinum, gold, red, graphite
  brand          String            @default("mastercard") // visa, mastercard, elo, amex
  lastFourDigits String?           // 4 últimos dígitos do cartão
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  transactions   CardTransaction[]
}

model CardTransaction {
  id               String        @id @default(uuid())
  cardId           String
  card             CreditCard    @relation(fields: [cardId], references: [id])
  description      String
  totalAmount      Float
  purchaseDate     DateTime
  installmentsCount Int          @default(1)
  installments     Installment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Installment {
  id            String          @id @default(uuid())
  transactionId String
  transaction   CardTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  number        Int
  amount        Float
  dueDate       DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}